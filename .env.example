# Telegram bot credentials: add these as server secrets, not to GitHub.
BOT_TOKEN=
BOT_USERNAME=
ADMIN_IDS=

# Optional database configuration.
DATABASE_URL=sqlite+aiosqlite:///./storage/mafia.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Safe defaults; the news channel link/title can also be edited in /admin.
DEFAULT_LANGUAGE=uz
NEWS_CHANNEL_URL=
NEWS_BONUS_CHANNEL=
SUPPORT_URL=https://t.me
MIN_PLAYERS=4
REGISTRATION_TIMEOUT=3600
NIGHT_TIMEOUT=60
DAY_DISCUSSION_TIMEOUT=45
DAY_VOTING_TIMEOUT=60
WINNER_REWARD_DOLLAR=15
WINNER_REWARD_DIAMOND=0
LOSER_REWARD_DOLLAR=10
LOSER_REWARD_DIAMOND=0
NIGHT_MEDIA_FILE_ID=
DAY_MEDIA_FILE_ID=
NIGHT_MEDIA_LOCAL=media/night.MP4
DAY_MEDIA_LOCAL=media/day.MP4
LOG_LEVEL=INFO
